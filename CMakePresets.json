{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Optimized release build for benchmarking",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Debug build with symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "sanitize",
      "displayName": "ASan + UBSan",
      "description": "Correctness runs: asserts on, AddressSanitizer + UndefinedBehaviorSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g",
        "LOB_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release",  "configurePreset": "release" },
    { "name": "debug",    "configurePreset": "debug" },
    { "name": "sanitize", "configurePreset": "sanitize" }
  ],
  "testPresets": [
    { "name": "release",  "configurePreset": "release",  "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } }
  ]
}
